PORT=5191
TWITCH_CLIENT_ID=6ggythtvgo572dxu8jo4xoaqtn37ix
TWITCH_EVENTSUB_SECRET=replace-with-a-local-random-secret
# Tests use only synthetic config and never load this file.
NODE_ENV=development
STATE_STORE=memory
OAUTH_ENABLED=false
# Required when OAUTH_ENABLED=true. Keep real values only in ignored local env.
TWITCH_CLIENT_SECRET=replace-with-registered-application-secret
TWITCH_STREAMER_ID=replace-with-numeric-streamer-user-id
TWITCH_BOT_ID=replace-with-distinct-numeric-bot-user-id
# Current route is /oauth/callback, NOT the originally registered /auth/callback.
# Owner must register the exact local URI before login and final HTTPS URI after deployment.
OAUTH_REDIRECT_URI=http://localhost:5191/oauth/callback
OAUTH_REDIRECT_ALLOWLIST=http://localhost:5191/oauth/callback
# Canonical base64 encoding of exactly 32 random bytes. Not a password.
TOKEN_ENCRYPTION_KEY=replace-with-base64-32-byte-key
# HTTPS callback needed for subscription creation; production requires it.
EVENTSUB_CALLBACK_URL=https://replace-with-owned-host.example/eventsub
# Only allowed project if STATE_STORE=firestore. Does not provision anything.
GOOGLE_CLOUD_PROJECT=raid-relic-hackathon
# Required in production: exact HTTPS origin, no path or trailing slash.
OVERLAY_ORIGIN=https://replace-with-owned-host.example
