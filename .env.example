PORT=5191
TWITCH_CLIENT_ID=6ggythtvgo572dxu8jo4xoaqtn37ix
TWITCH_EVENTSUB_SECRET=replace-with-a-local-random-secret
# Tests use only synthetic config and never load this file.
NODE_ENV=development
STATE_STORE=memory
OAUTH_ENABLED=false
# Required when OAUTH_ENABLED=true. Keep real values only in ignored local env.
TWITCH_CLIENT_SECRET=replace-with-registered-application-secret
TWITCH_STREAMER_ID=replace-with-numeric-streamer-user-id
TWITCH_BOT_ID=replace-with-distinct-numeric-bot-user-id
# Optional routing allowlist, max four numeric IDs including TWITCH_STREAMER_ID.
# Omit for single-streamer default. Does not grant OAuth or create subscriptions.
# Two-Keeper mode requires primary 1591805230 and bot 1591804828.
# KEEPER_CHANNEL_IDS=1591805230,1591806023
# Canonical /auth/callback or legacy /oauth/callback; only configured path is handled.
# Owner must register the exact local URI before login and final HTTPS URI after deployment.
OAUTH_REDIRECT_URI=http://localhost:5191/auth/callback
OAUTH_REDIRECT_ALLOWLIST=http://localhost:5191/auth/callback
# Canonical base64 encoding of exactly 32 random bytes. Not a password.
TOKEN_ENCRYPTION_KEY=replace-with-base64-32-byte-key
# HTTPS callback needed for subscription creation; production requires it.
EVENTSUB_CALLBACK_URL=https://replace-with-owned-host.example/eventsub
# Only allowed project if STATE_STORE=firestore. Does not provision anything.
GOOGLE_CLOUD_PROJECT=raid-relic-hackathon
# Required in production: exact HTTPS origin, no path or trailing slash.
OVERLAY_ORIGIN=https://replace-with-owned-host.example
# Production requires a full lowercase 40- or 64-hex reviewed Git commit hash.
# Local development may omit RELEASE_COMMIT; do not invent a release identity.

# Explicit owner-test capability gate; false/omitted keeps foundation readiness.
# Requires OAUTH_ENABLED=true, both exact KEEPER_CHANNEL_IDS above, primary/bot IDs,
# canonical /auth/callback, and same-origin HTTPS EventSub callback in production.
RAID_PILOT_ENABLED=false

# Optional Chronicle fiction: OFF. No key provisioning needed for templates.
# Enabling paid generation requires separate owner approval and BOTH true gates.
CHRONICLE_ENABLED=false
CHRONICLE_ALLOW_PAID=false
# Only bind an owner-provisioned Secret Manager env reference if later approved.
# Never place a real key here, in source, browser config or logs.
OPENAI_API_KEY=
# Optional private Forge model action shares BOTH Chronicle gates above (OFF).
# Public Forge templates need no key and never call a provider or write a DB.
# Future paid Forge also needs separate owner approval + explicit private acknowledgement.

# Optional P7 human-consented bot actions: all gates OFF by default.
P7_BOT_ACTIONS_ENABLED=false
P7_ANNOUNCEMENTS_ENABLED=false
P7_PIN_ENABLED=false
P7_SHOUTOUTS_ENABLED=false
P7_ALLOW_PIN_REPLACE=false
P7_PIN_DURATION_SECONDS=300
# Real canonical deployment must explicitly use false, not inherit an old preview.
P5_PREVIEW_READ_ONLY=false
# Parent binds the reviewed full source identity in production.
RELEASE_COMMIT=
# Operator-only daily-check transient input from an EXISTING grant; never save a value here.
TWITCH_BOT_ACCESS_TOKEN=

# P7 optional consent is explicit bot-only features=p7: 4 additional + 3 baseline = 7 scopes.
# Consent does not enable these operator-managed gates; source defaults remain OFF.
# Copy the APP start URL into the raidrelicbot browser, never its Twitch redirect/state URL.

# Optional forward-only anonymous verified-binding streak coverage; no legacy backfill.
P9_STREAK_ENABLED=false
# New marks only: hard safety rejection still applies. Invalid config stays manual.
MARK_AUTO_APPROVE_ENABLED=false
# JSON array, max32 normalized literal substring terms, total4096 bytes; [] holds none.
MARK_REVIEW_BLOCKLIST=["spoiler"]
# P9 CLIP DESIGN ONLY: no runtime hook/consent URL exists; true here cannot activate it.
CLIPS_ENABLED=false
CLIPS_ALLOW_CREATE=false
